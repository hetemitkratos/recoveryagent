# --- Database ---
DATABASE_URL=data/recovery.db

# --- Razorpay (live credentials — leave empty for demo mode) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- AI (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- AI (OpenRouter) — alternative to Gemini, supports many models ---
# Get a key at https://openrouter.ai/keys
# Browse models at https://openrouter.ai/models
# You need a CHAT/INSTRUCTION-TUNED text model (NOT embeddings or reranking).
# Recommended:
#   google/gemini-flash-2.0           (fast, cheap, good JSON)
#   openai/gpt-4o-mini                (fast, cheap, reliable JSON)
#   anthropic/claude-3.5-sonnet       (best reasoning, pricier)
#   meta-llama/llama-3.3-70b-instruct (open-source, cheap)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-flash-2.0
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=15000

# --- Recovery Engine ---
MAX_RETRIES=3
MAX_COMMUNICATIONS=3
MIN_COMMUNICATION_INTERVAL_HOURS=24
AI_CONFIDENCE_THRESHOLD=0.70
PTP_CONFIDENCE_THRESHOLD=0.80
HIGH_VALUE_THRESHOLD=1000000
ATTRIBUTION_WINDOW_HOURS=72
RECOVERY_AUTOMATION_ENABLED=true

# --- Demo ---
DEMO_MODE=true
DEMO_COMPRESS_DELAYS=true
DEMO_SEED=42

# --- Server ---
PORT=3000
FRONTEND_PORT=5173
NODE_ENV=development
LOG_LEVEL=info

# --- Security ---
# Comma-separated allowed CORS origins. Use '*' only in DEMO_MODE.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# API key for /api/* endpoints. Leave empty in DEMO_MODE to skip auth.
# REQUIRED in production (NODE_ENV=production).
API_KEY=
# Rate limiting: max requests per window per IP
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
# Max request body size in bytes (default 1MB)
BODY_LIMIT=1048576
# Reject webhook events older than this (seconds)
WEBHOOK_MAX_AGE_SECONDS=300
